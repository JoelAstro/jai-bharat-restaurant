# ==============================================================================
# JAI BHARAT FAMILY RESTAURANT - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env in both root or server/ and populate with actual credentials.
# NEVER commit the real .env file or credentials to source control!

# ------------------------------------------------------------------------------
# SERVER & APP CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 64-character random string for production:
# e.g., run in node: require('crypto').randomBytes(32).toString('hex')
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# DATABASE CONNECTION
# ------------------------------------------------------------------------------
# For local development with SQLite (zero external installation required):
DATABASE_URL="file:./dev.db"

# For production with PostgreSQL (Supabase, Neon, AWS RDS, Docker, etc.):
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/jaibharat_db?schema=public"

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY CREDENTIALS (SUPPLIED BY RESTAURANT OWNER)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard (Settings > API Keys)
# Keep in test mode (rzp_test_...) during staging and switch to live (rzp_live_...) for production
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# When credentials are left as placeholders, the server operates in safe Mock/Simulated
# mode so customer checkout can be tested end-to-end without failing transactions.

# ------------------------------------------------------------------------------
# SEEDED INITIAL ADMIN CREDENTIALS (FOR INITIAL BOOTSTRAP)
# ------------------------------------------------------------------------------
# Change these immediately upon first login!
ADMIN_EMAIL=admin@jaibharatrestaurant.com
ADMIN_PASSWORD=ChangeMeImmediately_Admin2026!
ADMIN_NAME="Jai Bharat Administrator"
ADMIN_PHONE="9876543210"

# ------------------------------------------------------------------------------
# CLOUDINARY (OPTIONAL / FOR FUTURE IMAGE UPLOADS)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

// Prisma Schema for Jai Bharat Family Restaurant
// Using NeonDB PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         String         @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  addresses     Address[]
  orders        Order[]
  favorites     Favorite[]
  notifications Notification[]

  @@index([email])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home") // "Home", "Work", "Other"
  street    String
  area      String?
  city      String
  pincode   String
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id                 String     @id @default(uuid())
  name               String
  slug               String     @unique
  description        String?
  displayOrder       Int        @default(0)
  isActive           Boolean    @default(true)
  imageUrl           String?
  cloudinaryPublicId String?    @map("cloudinary_public_id")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  items MenuItem[]

  @@index([slug])
}

model MenuItem {
  id                 String          @id @default(uuid())
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name               String
  description        String
  price              Int             // Price in paise (e.g. 25000 = ₹250.00)
  isVeg              Boolean         @default(true)
  isAvailable        Boolean         @default(true)
  isFeatured         Boolean         @default(false)
  imageUrl           String?
  cloudinaryPublicId String?         @map("cloudinary_public_id")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  variations ItemVariation[]
  addons     ItemAddon[]
  orderItems OrderItem[]
  favorites  Favorite[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
}

model ItemVariation {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // e.g., "Regular", "Half", "Full", "Large"
  price      Int      // Price in paise
  createdAt  DateTime @default(now())

  @@index([menuItemId])
}

model ItemAddon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // e.g., "Extra Gravy", "Raita", "Butter"
  price      Int      // Price in paise
  createdAt  DateTime @default(now())

  @@index([menuItemId])
}

model Coupon {
  id                 String    @id @default(uuid())
  code               String    @unique
  description        String?
  discountType       String    // "PERCENTAGE" | "FIXED"
  discountValue      Int       // Percentage (e.g., 20 for 20%) or Fixed amount in paise (e.g., 5000 for ₹50)
  minOrderAmount     Int       @default(0) // in paise
  maxDiscount        Int?      // in paise (maximum discount for percentage coupons)
  imageUrl           String?   @map("image_url")
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  expiresAt          DateTime?
  usageLimit         Int?      // Max global times this coupon can be used
  timesUsed          Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

model Order {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique // e.g., "JB-20261012-001"
  userId                  String
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderType               String               @default("DELIVERY") // "DELIVERY" | "TAKEAWAY"
  status                  String               @default("PENDING") // "PENDING" | "CONFIRMED" | "PREPARING" | "READY" | "COMPLETED" | "CANCELLED"
  paymentMethod           String               @default("COD") // "RAZORPAY" | "COD"
  paymentStatus           String               @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  
  // Monetary calculations in integer paise
  subtotal                Int
  deliveryFee             Int                  @default(0)
  tax                     Int                  @default(0)
  discount                Int                  @default(0)
  total                   Int

  couponCode              String?
  specialInstructions     String?
  deliveryAddressSnapshot String?              // Serialized JSON of selected address
  customerName            String
  customerPhone           String
  customerEmail           String

  razorpayOrderId         String?
  razorpayPaymentId       String?
  razorpaySignature       String?

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id            String            @id @default(uuid())
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String?
  menuItem      MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName      String
  variationName String?
  priceSnapshot Int               // Price per unit in paise at purchase time
  quantity      Int
  subtotal      Int               // (priceSnapshot + addons) * quantity in paise

  addons        OrderItemAddon[]

  @@index([orderId])
}

model OrderItemAddon {
  id            String    @id @default(uuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonName     String
  priceSnapshot Int       // Price in paise at purchase time

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model RestaurantSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model WebsiteImage {
  id                 String   @id @default(uuid())
  section            String   // "hero" | "categories" | "dum_ritual" | "about" | "owner" | "building"
  title              String
  imageUrl           String
  cloudinaryPublicId String?  @map("cloudinary_public_id")
  altText            String?
  displayOrder       Int      @default(0)
  isDefault          Boolean  @default(false)
  isEnabled          Boolean  @default(true)
  metadata           String?  // Optional JSON for custom metadata (e.g. slug for categories, step description)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([section])
  @@index([isEnabled])
  @@index([displayOrder])
}

model HomeBanner {
  id                 String   @id @default(uuid())
  title              String
  subtitle           String?
  imageUrl           String   @map("image_url")
  cloudinaryPublicId String?  @map("cloudinary_public_id")
  buttonText         String?  @map("button_text")
  buttonLink         String?  @map("button_link")
  displayOrder       Int      @default(0) @map("display_order")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("home_banners")
  @@index([isActive])
  @@index([displayOrder])
}

model AboutSection {
  id                 String   @id @default(uuid())
  sectionKey         String   @unique @map("section_key")
  title              String
  subtitle           String?
  content            String
  imageUrl           String?  @map("image_url")
  cloudinaryPublicId String?  @map("cloudinary_public_id")
  displayOrder       Int      @default(0) @map("display_order")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("about_sections")
  @@index([sectionKey])
  @@index([isActive])
}

model Offer {
  id                 String    @id @default(uuid())
  title              String
  description        String?
  code               String    @unique
  discountType       String    @default("PERCENTAGE") @map("discount_type") // "PERCENTAGE" | "FIXED"
  discountValue      Int       @map("discount_value")
  minOrderAmount     Int       @default(0) @map("min_order_amount")
  maxDiscount        Int?      @map("max_discount")
  imageUrl           String?   @map("image_url")
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  expiresAt          DateTime? @map("expires_at")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("offers")
  @@index([code])
  @@index([isActive])
}

